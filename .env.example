# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-secret

# Database (Turso)
TURSO_URL=libsql://sfchat-gelenmp.aws-eu-west-1.turso.io
TURSO_TOKEN=your-turso-token-here

# Email (Gmail SMTP)
SENDER_EMAIL=gelenmp@gmail.com
SENDER_PASSWORD=your-app-password-here

# Google Sheets
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your-script-id/exec

# Sync API (shared secret for sheets webhook)
SYNC_API_KEY=generate-a-random-uuid

# Sentry (optional)
SENTRY_DSN=

# Direct PostgreSQL connection (replaces Turso + Supabase REST)
# DATABASE_URL=postgresql://user:password@host:port/database
